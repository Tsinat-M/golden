rules_version = '2';

// Golden Lounge Oslo – sikkerhetsregler.
// - Alle (gjester) kan LESE menyen og innstillingene (bakgrunnsbilder).
// - Bare innloggede brukere (din admin-konto) kan ENDRE dem.
//
// Lim inn dette i Firebase-konsollen:
//   Firestore Database → fanen "Rules" → erstatt alt → "Publish".

service cloud.firestore {
  match /databases/{database}/documents {

    match /menu/{dish} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Alt annet er stengt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
